<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>paper_benchmarks</name>
  <version>0.0.1</version>
  <description>Benchmark tools for digital twin paper</description>
  <maintainer email="bari.marcello00@gmail.com">mbari</maintainer>
  <license>GPL-3.0-only</license>

  <depend>rclpy</depend>
  <depend>exoskeleton_safety_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>exoskeleton_description</depend>
  <depend>exoskeleton_utils</depend>
  <depend>robot_state_publisher</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
